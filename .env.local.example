# Copy to .env.local and fill in from `npx supabase status`
# (ANON_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY, SECRET_KEY → SUPABASE_SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SECRET_KEY=
# Public base URL of the site, used for citation links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
