# Copy to .env.local and fill in from `npx supabase status`
# (ANON_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY, SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of the site, used for citation links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
